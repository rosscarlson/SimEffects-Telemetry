<UserControl x:Class="GtTelemetry.App.Views.WatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Add -->
        <WrapPanel Margin="0,0,0,10">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Address" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                <TextBox x:Name="AddrBox" Width="120" ToolTip="Hex, e.g. 0x0099C3C8"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Type" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                <ComboBox x:Name="KindBox" Width="90"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Name" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Width="160"/>
            </StackPanel>
            <Button Content="Add" VerticalAlignment="Bottom" Click="Add_Click"/>
        </WrapPanel>

        <DockPanel Grid.Row="1">
            <Grid DockPanel.Dock="Top" Margin="10,0,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Name" Style="{StaticResource ColumnHeader}"/>
                <TextBlock Grid.Column="1" Text="Address" Style="{StaticResource ColumnHeader}"/>
                <TextBlock Grid.Column="2" Text="Type" Style="{StaticResource ColumnHeader}"/>
                <TextBlock Grid.Column="3" Text="Value" Style="{StaticResource ColumnHeader}" TextAlignment="Right" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="4" Text="Min" Style="{StaticResource ColumnHeader}" TextAlignment="Right" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="5" Text="Max" Style="{StaticResource ColumnHeader}" TextAlignment="Right" Margin="0,0,16,0"/>
            </Grid>
            <Border Background="{DynamicResource RoomBrush}" CornerRadius="8" Padding="0,4">
                <Grid>
                    <ListBox x:Name="List" Style="{StaticResource RowList}" SelectionMode="Extended" SelectionChanged="List_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="104"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AddressText}" Style="{StaticResource MonoText}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding KindText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="Val" Grid.Column="3" Text="{Binding ValueText}" Style="{StaticResource MonoText}" FontSize="13"
                                               FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding MinText}" Style="{StaticResource MonoText}" TextAlignment="Right" Margin="0,0,16,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding MaxText}" Style="{StaticResource MonoText}" TextAlignment="Right" Margin="0,0,16,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Changed}" Value="True">
                                        <Setter TargetName="Val" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Margin="24" MaxWidth="420"
                               Text="Nothing watched yet. Add an address above, or double-click a capture or scan result."/>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Selection actions -->
        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="RemoveButton" Content="Remove" Margin="0,0,6,8" Click="Remove_Click"/>
            <Button x:Name="ResetButton" Content="Reset min/max" Margin="0,0,16,8" Click="Reset_Click"/>
            <TextBox x:Name="RenameBox" Width="140" Margin="0,0,6,8" ToolTip="Name for the address map"/>
            <ComboBox x:Name="StatusBox" Width="120" Margin="0,0,6,8"/>
            <Button x:Name="SaveButton" Content="Save to map" Margin="0,0,16,8" Click="Save_Click"/>
            <TextBox x:Name="WriteBox" Width="90" Margin="0,0,6,8" TextAlignment="Right" ToolTip="Value to write into game memory via PINE"/>
            <Button x:Name="WriteButton" Content="Write" Margin="0,0,0,8" Click="Write_Click"/>
        </WrapPanel>
    </Grid>
</UserControl>
