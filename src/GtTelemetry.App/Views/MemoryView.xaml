<UserControl x:Class="GtTelemetry.App.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBox x:Name="AddrBox" Width="120" Text="0x00100000" KeyDown="AddrBox_KeyDown" ToolTip="Hex address; Enter to go"/>
                <Button Content="Go" Margin="6,0,0,0" Click="Go_Click"/>
                <Button Margin="12,0,0,0" Padding="7,3" ToolTip="Previous 256 bytes (Page Up)" Click="Prev_Click">
                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                </Button>
                <Button Margin="4,0,0,0" Padding="7,3" ToolTip="Next 256 bytes (Page Down)" Click="Next_Click">
                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock Text="Show as" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="ModeBox" Width="100" SelectionChanged="ModeBox_SelectionChanged"/>
                <ToggleButton x:Name="LiveChip" Style="{StaticResource ChipToggle}" Margin="12,0,0,0" IsChecked="True"
                              ToolTip="Refresh 10 times a second">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Live" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource RoomBrush}" CornerRadius="8" Padding="14,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1">
                                <TextBlock Text="{Binding AddressText}" Style="{StaticResource MonoText}" Width="92"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Ascii}" Style="{StaticResource MonoText}" Margin="16,0,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="T" Text="{Binding Text}" Style="{StaticResource MonoText}" TextAlignment="Right" Margin="0,0,8,0"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Changed}" Value="True">
                                                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="T" Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Zero}" Value="True">
                                                    <Setter TargetName="T" Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
