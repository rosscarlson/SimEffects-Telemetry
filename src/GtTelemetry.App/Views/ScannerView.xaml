<UserControl x:Class="GtTelemetry.App.Views.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Scan controls -->
        <WrapPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="Type" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                <ComboBox x:Name="KindBox" Width="90"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="Compare" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CompareBox" Width="200" SelectionChanged="CompareBox_SelectionChanged"/>
            </StackPanel>
            <StackPanel x:Name="ValueAPanel" Margin="0,0,12,8">
                <TextBlock x:Name="ValueALabel" Text="Value" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                <TextBox x:Name="ValueA" Width="110" TextAlignment="Right"/>
            </StackPanel>
            <StackPanel x:Name="ValueBPanel" Margin="0,0,12,8">
                <TextBlock Text="and" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                <TextBox x:Name="ValueB" Width="110" TextAlignment="Right"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,8" ToolTip="How close counts as equal or unchanged. Floats wobble, so 0.01 is a good start; 0 for integers.">
                <TextBlock Text="Tolerance" Style="{StaticResource SecondaryText}" Margin="0,0,0,4"/>
                <TextBox x:Name="TolBox" Width="70" TextAlignment="Right" Text="0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                <Button x:Name="FirstButton" Content="First scan" Style="{StaticResource AccentButton}" Click="First_Click"/>
                <Button x:Name="NextButton" Content="Next scan" Margin="6,0,0,0" Click="Next_Click"/>
                <Button x:Name="ResetButton" Content="New scan" Margin="6,0,0,0" Click="Reset_Click"/>
            </StackPanel>
        </WrapPanel>

        <DockPanel Grid.Row="1" Margin="0,4,0,8" LastChildFill="False">
            <TextBlock x:Name="CountText" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button x:Name="WatchButton" DockPanel.Dock="Right" Content="Watch selected" Click="Watch_Click"/>
        </DockPanel>

        <!-- Results -->
        <DockPanel Grid.Row="2">
            <Grid DockPanel.Dock="Top" Margin="10,0,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Address" Style="{StaticResource ColumnHeader}"/>
                <TextBlock Grid.Column="1" Text="Live" Style="{StaticResource ColumnHeader}" TextAlignment="Right" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="2" Text="At last scan" Style="{StaticResource ColumnHeader}" TextAlignment="Right" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="3" Text="Scan before" Style="{StaticResource ColumnHeader}"/>
            </Grid>
            <Border Background="{DynamicResource RoomBrush}" CornerRadius="8" Padding="0,4">
                <Grid>
                    <ListBox x:Name="ResultList" Style="{StaticResource RowList}" SelectionMode="Extended"
                             SelectionChanged="ResultList_SelectionChanged" MouseDoubleClick="ResultList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding AddressText}" Style="{StaticResource MonoText}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LiveText}" Style="{StaticResource MonoText}" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource MonoText}" TextAlignment="Right" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding PreviousText}" Style="{StaticResource MonoText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Margin="24" MaxWidth="440"
                               Text="Start with “Unknown initial value”, change something in game, then narrow down with Changed, Increased, Decreased or Unchanged."/>
                </Grid>
            </Border>
        </DockPanel>

        <!-- Pointer search -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorderBrush}" Padding="0,12,0,0" Margin="0,12,0,0">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="PointerButton" DockPanel.Dock="Right" Content="Find pointers" Margin="8,0,0,0" Click="Pointers_Click"/>
                    <TextBox x:Name="MaxOffsetBox" DockPanel.Dock="Right" Width="80" Text="0x1000" TextAlignment="Right"
                             ToolTip="Largest struct offset to allow (hex)"/>
                    <TextBlock DockPanel.Dock="Right" Text="within" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBox x:Name="PointerTarget" DockPanel.Dock="Right" Width="110" ToolTip="Address the pointer should lead to (hex)"/>
                    <TextBlock Text="Pointer search" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Text="Finds struct base pointers so addresses can survive car or track changes."/>
                </DockPanel>
                <TextBlock x:Name="PointerResults" Style="{StaticResource MonoText}" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="110"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
