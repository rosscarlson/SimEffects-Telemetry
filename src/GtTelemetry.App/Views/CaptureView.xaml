<UserControl x:Class="GtTelemetry.App.Views.CaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Session picker + primary action -->
        <DockPanel>
            <Button x:Name="StartButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" MinWidth="136" MinHeight="42"
                    Click="StartButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StartIcon" FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StartLabel" Text="Start session" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <CheckBox x:Name="SaveSnapshotsBox" DockPanel.Dock="Right" Content="Save step snapshots" Margin="0,0,16,0" VerticalAlignment="Center"
                      Checked="SaveSnapshotsBox_Changed" Unchecked="SaveSnapshotsBox_Changed"
                      ToolTip="Writes each step's 32 MB RAM snapshot to captures\ for offline analysis."/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="SessionBox" Width="260" DisplayMemberPath="Name" SelectionChanged="SessionBox_SelectionChanged"/>
                <Button Margin="6,0,0,0" Padding="7,3" MinHeight="26" ToolTip="Reload session scripts from the sessions folder" Click="Reload_Click">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"/>
                </Button>
                <TextBlock x:Name="DurationText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,14">
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"/>
            <TextBlock x:Name="SetupText" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Steps -->
            <Border Background="{DynamicResource RoomBrush}" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Steps" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="StepList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="20" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <Ellipse x:Name="Ring" Margin="-3" StrokeThickness="2" Stroke="{DynamicResource SuccessBrush}" Visibility="Collapsed"/>
                                            <Ellipse x:Name="Disc" Fill="{DynamicResource ControlBrush}" Stroke="{DynamicResource ControlBorderBrush}"/>
                                            <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="Say" Text="{Binding Say}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Active">
                                            <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                            <Setter TargetName="Say" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Sampling">
                                            <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource SuccessBrush}"/>
                                            <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                            <Setter TargetName="Say" Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Pulse">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.3" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="Pulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter TargetName="Say" Property="Opacity" Value="0.7"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Results -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Candidates" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ResultSummary" DockPanel.Dock="Left" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save to map" Margin="6,0,0,0" Click="Save_Click"
                            ToolTip="Saves the selected candidate as a named candidate address"/>
                    <TextBox x:Name="NameBox" DockPanel.Dock="Right" Width="130" ToolTip="Name for the address map, e.g. throttle"/>
                    <Button x:Name="WatchButton" DockPanel.Dock="Right" Content="Watch" Margin="0,0,6,0" Click="Watch_Click"
                            ToolTip="Adds the selected candidates to the watch list"/>
                </DockPanel>
                <Grid DockPanel.Dock="Top" Margin="10,0,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Address" Style="{StaticResource ColumnHeader}"/>
                    <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource ColumnHeader}"/>
                    <TextBlock Grid.Column="2" Text="Score" Style="{StaticResource ColumnHeader}"/>
                    <TextBlock Grid.Column="3" Text="Live" Style="{StaticResource ColumnHeader}" TextAlignment="Right" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="4" Text="Value at end of each step" Style="{StaticResource ColumnHeader}"/>
                </Grid>
                <Border Background="{DynamicResource RoomBrush}" CornerRadius="8" Padding="0,4">
                    <Grid>
                        <ListBox x:Name="ResultList" Style="{StaticResource RowList}" SelectionMode="Extended"
                                 SelectionChanged="ResultList_SelectionChanged" MouseDoubleClick="ResultList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Notes}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding AddressText}" Style="{StaticResource MonoText}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding KindText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ScoreText}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding LiveText}" FontWeight="SemiBold" TextAlignment="Right" Margin="0,0,12,0"
                                                   Style="{StaticResource MonoText}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding ValuesText}" Style="{StaticResource MonoText}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" Margin="24" MaxWidth="420"
                                   Text="Pick a session, get set up in game, then press Start. The voice tells you what to do; a beep means it's watching."/>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
