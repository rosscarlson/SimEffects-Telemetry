    { "say": "Full throttle in a straight line.", "sample": 5, "label": 2 },
    { "say": "Brake hard to a stop.", "sample": 4, "label": 3 },
    { "say": "Pull away and weave left and right.", "sample": 9, "label": 4 },
    { "say": "Drive over a curb with the left wheels, then the right.", "sample": 14, "label": 5 },
    { "say": "Drive onto the grass or gravel with all four wheels.", "sample": 8, "label": 6 },
    { "say": "Back onto the track.", "sample": 6, "label": 7 },
    { "say": "Spin the rear wheels: stop, then full throttle from standstill.", "sample": 7, "label": 8 },
    { "say": "Brake and stop.", "sample": 4, "label": 9 }
